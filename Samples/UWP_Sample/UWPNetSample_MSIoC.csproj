<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
	<UseUwp>true</UseUwp>
	<Platforms>x64;arm64</Platforms>
	<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
	<DefaultLanguage>en-US</DefaultLanguage>
	<PublishAot>true</PublishAot>
	<!--IL trimming disabled for Microsoft.UI.Xaml compatibility-->
	<!--<PublishTrimmed>false</PublishTrimmed>-->
	<PublishProfile>win-$(Platform).pubxml</PublishProfile>
	<DisableRuntimeMarshalling>false</DisableRuntimeMarshalling>
	<EnableMsixTooling>true</EnableMsixTooling>
	<CsWinRTAotWarningLevel>3</CsWinRTAotWarningLevel>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	<GenerateAppInstallerFile>False</GenerateAppInstallerFile>
	<AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
	<PackageCertificateThumbprint>35D754E8113EFF01266CE1A79DD7837E1C6F399F</PackageCertificateThumbprint>
	<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
	<AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
	<GenerateTestArtifacts>False</GenerateTestArtifacts>
	<AppxBundle>Never</AppxBundle>
	<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
	<SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup>
	<DefineConstants>$(DefineConstants);WINDOWS_UWP</DefineConstants>
  </PropertyGroup>

	<ItemGroup>
	  <!-- Trimmer root descriptor for AOT compatibility -->
	  <TrimmerRootDescriptor Include="TrimmerRootDescriptor.xml" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="CommunityToolkit.Common" Version="8.4.2" />
	  <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.UWP.Helpers" Version="8.2.251219" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
	  <PackageReference Include="Microsoft.UI.Xaml" Version="2.8.7" />
		<PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
	</ItemGroup>



	<!-- Add Source Generator AdditionalFiles (compiled inline, no project reference required) -->

	<!-- Configure Analyzer path for Source Generator -->
	<!--<ItemGroup>
		<Analyzer Include="..\..\ViewModelGenerator\bin\Debug\netstandard2.0\*.dll" Condition="Exists('..\..\ViewModelGenerator\bin\Debug\netstandard2.0\*.dll')" />
	</ItemGroup>-->

	<Import Project="..\..\UNOversalTemplate.Services\UNOversalTemplate.Services.projitems" Label="Shared" />
	<Import Project="..\..\UNOversalTemplate.Core\UNOversalTemplate.Core.projitems" Label="Shared" />
	<Import Project="..\..\UNOversalTemplate.IoC.MS\UNOversalTemplate.IoC.MS.projitems" Label="Shared" />
</Project>