<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseUwp>true</UseUwp>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PublishAot>true</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
	<EnableMsixTooling>true</EnableMsixTooling>
	<CsWinRTAotWarningLevel>3</CsWinRTAotWarningLevel>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	<GenerateAppInstallerFile>False</GenerateAppInstallerFile>
	<AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
	<PackageCertificateThumbprint>35D754E8113EFF01266CE1A79DD7837E1C6F399F</PackageCertificateThumbprint>
	<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
	<AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
	<GenerateTestArtifacts>False</GenerateTestArtifacts>
	<AppxBundle>Never</AppxBundle>
	<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
    <DefineConstants>$(DefineConstants);WINDOWS_UWP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DefineConstants>$(DefineConstants);WINDOWS_UWP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|arm64'">
    <DefineConstants>$(DefineConstants);WINDOWS_UWP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
    <DefineConstants>$(DefineConstants);WINDOWS_UWP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DefineConstants>$(DefineConstants);WINDOWS_UWP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|arm64'">
    <DefineConstants>$(DefineConstants);WINDOWS_UWP</DefineConstants>
  </PropertyGroup>
	<ItemGroup>
		<Compile Remove="AppPackages\**" />
		<Compile Remove="BundleArtifacts\**" />
		<EmbeddedResource Remove="AppPackages\**" />
		<EmbeddedResource Remove="BundleArtifacts\**" />
		<None Remove="AppPackages\**" />
		<None Remove="BundleArtifacts\**" />
		<Page Remove="AppPackages\**" />
		<Page Remove="BundleArtifacts\**" />
		<None Remove="Properties\Default.rd.xml" />
		<Compile Remove="Properties\AssemblyInfo.cs" />
		<PRIResource Remove="AppPackages\**" />
		<PRIResource Remove="BundleArtifacts\**" />
	</ItemGroup>
	<ItemGroup>
		<None Remove="Properties\Default.rd.xml" />
		<Compile Remove="Properties\AssemblyInfo.cs" />
		<PRIResource Remove="AppPackages\**" />
		<PRIResource Remove="BundleArtifacts\**" />
		<!-- Trimmer root descriptor for AOT compatibility -->
		<!--<TrimmerRootDescriptor Include="TrimmerRootDescriptor.xml" />-->
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="CommunityToolkit.Common" Version="8.4.2" />
	  <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	  <PackageReference Include="CommunityToolkit.UWP.Helpers" Version="8.2.251219" />
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
	  <PackageReference Include="Microsoft.UI.Xaml" Version="2.8.7" />
	  <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
	</ItemGroup>

	<!-- Add Source Generator AdditionalFiles (compiled inline, no project reference required) -->

	<!-- Configure Analyzer path for Source Generator -->
	<ItemGroup>
		<Analyzer Include="..\..\ViewModelGenerator\bin\Debug\netstandard2.0\*.dll" Condition="Exists('..\..\ViewModelGenerator\bin\Debug\netstandard2.0\*.dll')" />
	</ItemGroup>

	<Import Project="..\..\UNOversalTemplate.Services\UNOversalTemplate.Services.projitems" Label="Shared" />
	<Import Project="..\..\UNOversalTemplate.Core\UNOversalTemplate.Core.projitems" Label="Shared" />
	<Import Project="..\..\UNOversalTemplate.IoC.MS\UNOversalTemplate.IoC.MS.projitems" Label="Shared" />
</Project>