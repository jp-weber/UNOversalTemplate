<linker>
  <!-- Preserve all types that must be available at runtime for reflection-based dependency injection -->

  <!-- UNOversal Logging - Required for ILoggerFacade resolution -->
  <assembly fullname="UNOversal.Logging">
	<type fullname="UNOversal.Logging.ILoggerFacade" preserve="all" />
	<type fullname="UNOversal.Logging.DebugLogger" preserve="all" />
	<type fullname="UNOversal.Logging.EmptyLogger" preserve="all" />
	<type fullname="UNOversal.Logging.Category" preserve="all" />
	<type fullname="UNOversal.Logging.Priority" preserve="all" />
  </assembly>

  <!-- UNOversal Events - Required for IEventAggregator resolution -->
  <assembly fullname="UNOversal.Events">
	<type fullname="UNOversal.Events.IEventAggregator" preserve="all" />
	<type fullname="UNOversal.Events.EventAggregator" preserve="all" />
	<type fullname="UNOversal.Events.PubSubEvent" preserve="all" />
	<type fullname="UNOversal.Events.EventSubscription" preserve="all" />
	<type fullname="UNOversal.Events.BackgroundEventSubscription" preserve="all" />
	<type fullname="UNOversal.Events.DispatcherEventSubscription" preserve="all" />
  </assembly>

  <!-- UNOversal.Core IoC - Required for container operations and generic type registration -->
  <assembly fullname="UNOversal">
	<namespace fullname="UNOversal.Ioc" preserve="all" />
	<namespace fullname="UNOversal.Mvvm" preserve="all" />
	<type fullname="UNOversal.UNOversalApplicationBase" preserve="all" />
  </assembly>

  <!-- Microsoft.Extensions.DependencyInjection - Required for reflection-based service activation -->
  <assembly fullname="Microsoft.Extensions.DependencyInjection.Abstractions" preserve="all" />
  <assembly fullname="Microsoft.Extensions.DependencyInjection">
	<!-- Preserve all of MS.DI as it uses reflection for activation -->
	<namespace fullname="Microsoft.Extensions.DependencyInjection" preserve="all" />
  </assembly>

  <!-- All ViewModels - Required for dynamic creation and binding -->
  <assembly fullname="UWPNetSample_MSIoC">
	<namespace fullname="UWPNetSample_MSIoC.ViewModels" preserve="all" />
  </assembly>

  <!-- Windows/UI assemblies that might interact with reflection -->
  <assembly fullname="Windows.UI.Xaml" preserve="all" />
  <assembly fullname="Microsoft.UI.Xaml" preserve="all" />

  <!-- Microsoft.UI.Xaml Controls — Critical for NavigationView and all WinUI controls -->
  <assembly fullname="Microsoft.UI.Xaml">
    <!-- Root types — required by XamlTypeInfo system -->
    <type fullname="Microsoft.UI.Xaml.Application" preserve="all" />
    <type fullname="Microsoft.UI.Xaml.ApplicationLifeCycleActivatedEventArgs" preserve="all" />
    <type fullname="Microsoft.UI.Xaml.Controls.Control" preserve="all" />
    <type fullname="Microsoft.UI.Xaml.Controls.ControlTemplate" preserve="all" />
    <type fullname="Microsoft.UI.Xaml.Controls.Frame" preserve="all" />
    <type fullname="Microsoft.UI.Xaml.Controls.NavigationView" preserve="all" />
    <type fullname="Microsoft.UI.Xaml.Controls.NavigationViewItem" preserve="all" />
    <type fullname="Microsoft.UI.Xaml.Controls.Primitives.ContentPresenter" preserve="all" />
    <type fullname="Microsoft.UI.Xaml.Controls.Primitives.FlyoutBase" preserve="all" />
    <type fullname="Microsoft.UI.Xaml.Controls.Primitives.NavigationViewPane" preserve="all" />
    <type fullname="Microsoft.UI.Xaml.Data.Binding" preserve="all" />
    <type fullname="Microsoft.UI.Xaml.DependencyObject" preserve="all" />
    <type fullname="Microsoft.UI.Xaml.FrameworkElement" preserve="all" />
    <type fullname="Microsoft.UI.Xaml.ResourceDictionary" preserve="all" />
    <type fullname="Microsoft.UI.Xaml.Style" preserve="all" />

    <!-- WinUI namespaces — XamlTypeInfo, Templating, Input & more -->
    <namespace fullname="Microsoft.UI.Xaml" preserve="all" />
    <namespace fullname="Microsoft.UI.Xaml.Automation" preserve="all" />
    <namespace fullname="Microsoft.UI.Xaml.Automation.Peers" preserve="all" />
    <namespace fullname="Microsoft.UI.Xaml.Controls" preserve="all" />
    <namespace fullname="Microsoft.UI.Xaml.Controls.Primitives" preserve="all" />
    <namespace fullname="Microsoft.UI.Xaml.Data" preserve="all" />
    <namespace fullname="Microsoft.UI.Xaml.Documents" preserve="all" />
    <namespace fullname="Microsoft.UI.Xaml.Input" preserve="all" />
    <namespace fullname="Microsoft.UI.Xaml.Interop" preserve="all" />
    <namespace fullname="Microsoft.UI.Xaml.Markup" preserve="all" />
    <namespace fullname="Microsoft.UI.Xaml.Media" preserve="all" />
    <namespace fullname="Microsoft.UI.Xaml.Media.Animation" preserve="all" />
    <namespace fullname="Microsoft.UI.Xaml.Shapes" preserve="all" />
    <namespace fullname="Microsoft.UI.Xaml.XamlTypes" preserve="all" />
  </assembly>

  <!-- Windows.UI.Xaml — base platform types, VSM, Media -->
  <assembly fullname="Windows.UI.Xaml">
    <namespace fullname="Windows.UI.Xaml" preserve="all" />
    <namespace fullname="Windows.UI.Xaml.Automation" preserve="all" />
    <namespace fullname="Windows.UI.Xaml.Controls" preserve="all" />
    <namespace fullname="Windows.UI.Xaml.Controls.Primitives" preserve="all" />
    <namespace fullname="Windows.UI.Xaml.Data" preserve="all" />
    <namespace fullname="Windows.UI.Xaml.Media" preserve="all" />
    <namespace fullname="Windows.UI.Xaml.Media.Animation" preserve="all" />
  </assembly>

  <!-- XamlTypeInfo for WinUI — required during debug/debugger scenarios -->
  <assembly fullname="Microsoft.UI.Xaml">
    <namespace fullname="Microsoft.UI.Xaml.XamlTypeInfo" preserve="all" />
  </assembly>
</linker>

